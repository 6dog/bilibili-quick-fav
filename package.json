{
  "name": "bilibili-quick-fav",
  "version": "2.0.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build-extension.mjs",
    "package": "npm run build && node scripts/package-extension.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run package",
    "test:browser": "node scripts/check-extension-browser.mjs",
    "browser:load": "node scripts/load-extension-browser.mjs",
    "test:release": "bash scripts/test-release-zip.sh",
    "test:release:write": "QFAV_ALLOW_FAVORITE_WRITE=1 bash scripts/test-release-zip.sh"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.34",
    "@types/node": "^24.10.1",
    "archiver": "^7.0.1",
    "esbuild": "^0.28.1",
    "jsdom": "^27.2.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
